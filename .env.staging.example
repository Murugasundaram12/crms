# ==============================================================================
# HouseFix360 CRM — Dedicated MySQL Staging Environment Template
# File: .env.staging.example
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.staging or .env.testing.
# 2. Fill in the dedicated staging user credentials (<GENERATED_STAGING_PASSWORD>).
# 3. DO NOT commit actual secrets or staging credentials to Git.
# ==============================================================================

APP_NAME="HouseFix360 CRM (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Dedicated MySQL Staging Database Connection
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crms_staging
DB_USERNAME=crms_staging_user
DB_PASSWORD=<GENERATED_STAGING_PASSWORD>

# ------------------------------------------------------------------------------
# Staging Migration Guard Approvals (Strictly Enforced by tests/run-safe-migrate.php)
# ------------------------------------------------------------------------------
CRMS_STAGING_APPROVED_CONNECTION=mysql
CRMS_STAGING_APPROVED_DATABASE=crms_staging
CRMS_STAGING_APPROVED_HOST=127.0.0.1
CRMS_STAGING_APPROVED_PORT=3306

# ------------------------------------------------------------------------------
# Test Safety Guard Approvals (Strictly Enforced by tests/bootstrap.php)
# ------------------------------------------------------------------------------
CRMS_TEST_APPROVED_CONNECTION=mysql
CRMS_TEST_APPROVED_DATABASE=crms_staging
CRMS_TEST_APPROVED_HOST=127.0.0.1
CRMS_TEST_APPROVED_PORT=3306

# ------------------------------------------------------------------------------
# Side-Effect Mitigation (Zero External Communications or Integrations)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CACHE_STORE=file
BROADCAST_CONNECTION=null
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
